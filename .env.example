# =============================================================================
# SurakshaNet Environment Variables Template
# Copy this file to '.env' and fill in your actual values.
# DO NOT commit your '.env' file to source control.
# =============================================================================

# --- Backend Configuration ---
COMPOSIO_API_KEY=your_composio_api_key_here
DATABASE_URL=postgresql+pg8000://surakshanet:your_postgres_password_here@localhost:5432/surakshanet_db
SLACK_CHANNEL_ID=#surakshanet-alerts
BLOCKCHAIN_URL=http://localhost:3001

# --- Authentication Service Configuration ---
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_here
PORT=4000

# --- Frontend Configuration (Vite) ---
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
